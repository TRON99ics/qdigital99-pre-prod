# Supabase (required) — same project/table as your other sites if sharing leads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (required)
RESEND_API_KEY=
RESEND_FROM=QDigital99 <noreply@qdigital99.com>

# Public site URL (used for CORS and email assets)
PUBLIC_BASE_URL=https://qdigital99.com
EMAIL_IMAGE_URL=

# Optional comma-separated extra CORS origins (Vercel previews, etc.)
# ALLOWED_ORIGINS=https://qdigital99-git-main-xxx.vercel.app

# Upstash Redis — IP + email rate limiting (recommended for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot protection (recommended for production)
# On Vercel set TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY (runtime via /api/contact-config).
# VITE_TURNSTILE_SITE_KEY is optional — local Vite fallback when the API is not running.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# VITE_TURNSTILE_SITE_KEY=

# Frontend (optional)
# VITE_SITE_URL=https://qdigital99.com
# VITE_CONTACT_API_URL=/api/contact
# VITE_LEAD_SHEET_URL=

# Local dev: Cloudflare test keys (always pass verification)
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
